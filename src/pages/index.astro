---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Photo from '../components/Photo.astro';
const projects = [
 {name:'Bella’s Bakery', category:'Food & local business', key:'bakery', path:'/demos/bakery/', image:'starter-bakery-interior', note:'A little warmth. A lot of character.', details:'Menu browsing, a welcoming story, and a simple custom-order enquiry.'},
 {name:'Apex Fitness', category:'Fitness & membership', key:'fitness', path:'/demos/fitness/', image:'standard-exterior', note:'Built for the next personal best.', details:'An interactive class timetable, clear memberships, and a trial-session journey.'},
 {name:'Noir & Co.', category:'Interiors & professional services', key:'interiors', path:'/demos/interiors/', image:'premium-portfolio-1', note:'Room for a different perspective.', details:'An editorial portfolio, individual project stories, and a considered consultation flow.'}
];
const packages = [
 {name:'Starter', number:'01', price:'800', lead:'A considered first impression.', description:'For a focused business that needs a clear, credible home online.', features:['One page, up to five sections','Responsive design and enquiry form','Page titles, metadata and sitemap','Two consolidated revision rounds'], tone:''},
 {name:'Standard', number:'02', price:'1,500', lead:'Space for your business to grow.', description:'For businesses with more to show, explain, and share.', features:['Up to five pages','Custom design and image gallery','Analytics setup, with consent controls where needed','Two consolidated revision rounds'], tone:'featured'},
 {name:'Premium', number:'03', price:'3,000', lead:'Your brand, fully expressed.', description:'For a richer visual story and more individual requirements.', features:['Bespoke visual direction','Purposeful motion and rich project pages','CMS requirements scoped in your proposal','Two consolidated revision rounds'], tone:''}
];
---
<Layout title="Violet Media Web Design | Distinctive Websites, Designed in Perth" description="Thoughtfully designed websites for independent businesses. Explore three interactive concepts, compare clear AUD packages, and discuss your project with Violet Media.">
  <Header links={[["The work","#work"],["Our approach","#approach"],["Packages","#pricing"]]} />
  <main id="main">
    <section class="studio-hero wrap">
      <div class="hero-copy fade-in">
        <p class="eyebrow">Independent design. Perth, Australia.</p>
        <h1>Your business.<br/>A better<br/><em>first impression.</em></h1>
        <p class="hero-description">Distinctive websites for businesses ready for their next chapter. Thoughtfully designed. Clear to use. Made for you.</p>
        <div class="actions"><a class="button violet-button" href="#work">Explore the websites <span aria-hidden="true">↗</span></a><a class="text-link" href="#contact">Let’s talk about yours <span aria-hidden="true">→</span></a></div>
        <div class="hero-footnote"><span class="status-dot"></span>Designed in Perth. Working with businesses everywhere.</div>
      </div>
      <div class="hero-composition" aria-label="Three website concepts">
        <div class="composition-grid" aria-hidden="true"></div>
        <a href="/demos/interiors/" class="mini-browser interior-browser" aria-label="Explore the Noir and Co. interior design concept"><div class="browser-chrome"><span>● ● ●</span><span>NOIR & CO. / INTERIORS</span><span>↗</span></div><Photo name="premium-portfolio-1" alt="Warm architectural interior overlooking the city" eager sizes="(max-width: 900px) 90vw, 45vw"/><div class="mini-interior-copy"><span>NOIR & CO.</span><strong>Spaces for<br/><em>living well.</em></strong><small>RESIDENTIAL · COMMERCIAL · CONSIDERED</small></div></a>
        <a href="/demos/bakery/" class="mini-browser bakery-browser" aria-label="Explore the Bella’s Bakery concept"><div class="browser-chrome"><span>● ● ●</span><span>BELLA’S BAKERY</span></div><Photo name="starter-croissant" alt="Golden croissants in a bakery" sizes="(max-width: 900px) 50vw, 22vw"/><div class="mini-bakery-copy">Good mornings<br/><em>start here.</em><span>BAKED WITH TIME. SHARED WITH LOVE.</span></div></a>
        <a href="/demos/fitness/" class="fitness-chip" aria-label="Explore the Apex Fitness concept"><span>APEX<span class="fitness-chip-dot">↗</span></span><strong>SHOW UP.<br/>GET STRONGER.</strong><small>FITNESS, WITH DIRECTION.</small></a>
        <span class="composition-caption">THREE BUSINESSES. THREE DIFFERENT WORLDS.</span>
      </div>
    </section>
    <div class="studio-strip"><div class="wrap"><span>Designed around your customers</span><span>Built for every screen</span><span>A clear path to enquiry</span><span>Quality for the ages</span></div></div>
    <section id="work" class="section work-section">
      <div class="wrap">
        <div class="section-heading"><div><p class="eyebrow">01 / Explore the possibilities</p><h2>Different businesses.<br/><em>Distinct identities.</em></h2></div><p>Three original concept websites. Explore the design, try the interactions, and imagine what we could create for your business.</p></div>
        <div class="project-grid">{projects.map((p,i) => <article class={`project-card project-${p.key}`}><a class="project-image" href={p.path} aria-label={`Explore ${p.name}`}><Photo name={p.image} alt={`${p.name} concept imagery`} sizes="(max-width: 700px) 100vw, 33vw"/><span class="project-overlay-label">{p.name}</span><span class="project-arrow" aria-hidden="true">↗</span></a><div class="project-meta"><span>0{i+1} / {p.category}</span><span>Concept</span></div><h3>{p.note}</h3><p>{p.details}</p><a class="text-link" href={p.path}>Explore {p.name} <span aria-hidden="true">↗</span></a></article>)}</div>
        <p class="work-disclosure">These are fictional business concepts created to demonstrate our design and development. They are not client commissions.</p>
        <a href="https://violetmedia.org/" class="real-work" target="_blank" rel="noopener noreferrer"><span>Also built by us</span><strong>Violet Media — our creative home</strong><span>Visit the live site ↗</span></a>
      </div>
    </section>
    <section id="approach" class="approach-section section"><div class="wrap approach-grid"><div><p class="eyebrow">02 / Substance, with style</p><h2>Good design<br/>has a <em>job to do.</em></h2><p class="lead">Make you understood. Build confidence. Help the right people take the next step.</p><a class="text-link" href="#contact">Tell us what you need <span aria-hidden="true">↗</span></a></div><div class="approach-list">{[['01','A design that belongs to you','Your audience, personality, and purpose shape the site. Every project starts with a conversation.'],['02','Clear on every screen','Thoughtful mobile layouts, readable content, accessible navigation, and fast-loading images.'],['03','A useful next step','An enquiry, a booking integration, or a visit to your shop. We design around the action that matters.'],['04','A straightforward handover','Your domain stays yours. We explain your hosting, source files, and ongoing options before you commit.']].map(([n,t,d])=><div><span>{n}</span><div><h3>{t}</h3><p>{d}</p></div></div>)}</div></div></section>
    <section class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">03 / The person behind the pixels</p><h2>A small studio.<br/><em>A personal approach.</em></h2></div><p>Work directly with Peter Z. Sarosi, Founder & Creative Director of Violet Media. Creative direction, visual storytelling, and web design under one roof.</p></div><div class="process-grid">{[['01','Listen','We define your audience, content, scope, and the job your website needs to do.'],['02','Design','You see the visual direction and a working preview before we refine the details.'],['03','Refine','Two consolidated rounds of feedback keep decisions clear and the work moving.'],['04','Launch','We check the site, connect your domain, and walk you through the finished work.']].map(([n,t,d])=><div><span class="process-number">{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></div></section>
    <section id="pricing" class="section pricing-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">04 / A clear place to start</p><h2>Find the right<br/><em>shape for your project.</em></h2></div><p>Packages start here. All prices are in Australian dollars. We confirm your inclusions, timeline, and final quote before work begins.</p></div><div class="package-grid">{packages.map(p=><article class:list={['package-card',p.tone]}><div class="package-top"><span>{p.name}</span><span>{p.number}</span></div><p class="package-price"><small>From AUD</small>{p.price}</p><h3>{p.lead}</h3><p>{p.description}</p><ul>{p.features.map(f=><li>{f}</li>)}</ul><a class="button" data-package={p.name} href="#contact">Discuss {p.name} <span aria-hidden="true">↗</span></a></article>)}</div><div class="pricing-footnotes"><p><strong>Clear scope first.</strong> Domain registration, paid services, booking systems, ecommerce, and substantial content creation are itemised where required. Hosting arrangements and any usage limits are confirmed in your proposal.</p><p><strong>Payment & support.</strong> 50% deposit, 50% on completion. Optional ongoing updates and support: AUD 150–200/month, with the scope agreed in advance. No maintenance subscription is required.</p></div></div></section>
    <section class="section faq-section"><div class="wrap faq-grid"><div><p class="eyebrow">A few useful answers</p><h2>Before we<br/><em>get started.</em></h2></div><div>{[['Can you redesign my existing website?','Yes. Share your current website and what is no longer working for you. We will review which content and assets to keep, what needs rebuilding, and how to preserve useful existing links.'],['Are the concept websites templates?','They are original demonstration projects. They show different design directions and customer journeys. Your project is scoped and designed around your own business.'],['What do I need to provide?','Your business details, services, goals, and any existing logo, imagery, or copy. We identify missing content during discovery and quote any additional production separately.'],['Can I update the site myself?','If regular editing is important, tell us at the start. We can scope a content management system and handover. It is not automatically part of every package.'],['How long does a project take?','We agree on a delivery schedule once we know the scope and content readiness. Clear feedback and complete content help keep the project on track.'],['Do you only work with Perth businesses?','We are based in Perth and can work remotely with businesses elsewhere in Australia and internationally. Proposals are quoted in AUD.']].map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></section>
    <section id="contact" class="section contact-section"><div class="wrap contact-grid"><div><p class="eyebrow">Your next chapter</p><h2>Let’s make<br/>your business<br/><em>look the part.</em></h2><p>Tell us where you are now and where you want to go. A few details are enough to start the conversation.</p><a href="mailto:info@violetmedia.org" class="contact-email">info@violetmedia.org ↗</a><p class="contact-location">PERTH, WESTERN AUSTRALIA<br/>PERSONAL SERVICE. WHEREVER YOU ARE.</p></div><form id="project-form" method="POST" action="https://formsubmit.co/info@violetmedia.org"><input type="hidden" name="_subject" value="Website project enquiry — Violet Media"/><input type="hidden" name="_next" value="https://web.violetmedia.org/thank-you/"/><input type="text" name="_honey" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true"/><input type="hidden" name="concept" id="concept" value=""/><p id="concept-note" class="concept-enquiry" hidden></p><div class="form-grid"><div class="field"><label for="name">Your name *</label><input id="name" name="name" autocomplete="name" required maxlength="120"/></div><div class="field"><label for="email">Email address *</label><input type="email" id="email" name="email" autocomplete="email" required maxlength="254"/></div><div class="field"><label for="business">Business name</label><input id="business" name="business" autocomplete="organization" maxlength="150"/></div><div class="field"><label for="website">Current website, if you have one</label><input id="website" name="website" type="url" placeholder="https://" maxlength="500"/></div><div class="field"><label for="package">Where would you like to start?</label><select id="package" name="package"><option value="Not sure">Let’s work it out together</option><option value="Starter">Starter — from AUD 800</option><option value="Standard">Standard — from AUD 1,500</option><option value="Premium">Premium — from AUD 3,000</option></select></div><div class="field"><label for="timeline">Your ideal timeframe</label><select id="timeline" name="timeline"><option>Flexible / exploring</option><option>Within a month</option><option>Within 1–3 months</option><option>Later this year</option></select></div><div class="field full"><label for="message">What would you like your website to do? *</label><textarea id="message" name="message" required minlength="10" maxlength="5000" placeholder="Tell us about your business, your customers, and what you have in mind."></textarea></div></div><button class="button violet-button" type="submit">Send your project enquiry <span aria-hidden="true">↗</span></button><p class="form-note">Your details are sent through FormSubmit to Violet Media to respond to your enquiry. Please avoid sending confidential information. <a href="/privacy/">How enquiries are handled</a>.</p><p class="form-status" role="status"></p></form></div></section>
  </main>
  <footer class="footer"><div class="wrap"><div class="footer-top"><a class="wordmark" href="/">Violet Media<small>WEB DESIGN</small></a><div class="footer-links"><a href="#work">The work</a><a href="#pricing">Packages</a><a href="https://violetmedia.org/">Our creative studio ↗</a><a href="/privacy/">Privacy</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Violet Media · ABN 20 188 436 344</span><span>Perth, Western Australia</span><span>Quality for the ages.</span></div></div></footer>
</Layout>
