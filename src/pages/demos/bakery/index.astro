---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import DemoBanner from '../../../components/DemoBanner.astro';
import Photo from '../../../components/Photo.astro';
const menu=[['Sourdough loaf','sourdough','bread','9.50','A slow rise, a deep crust, and a soft centre.'],['Butter croissant','croissant','pastry','5.50','Golden layers. A little messy. Worth every crumb.'],['Lemon drizzle cake','cake','cake','7.00','A bright little slice of the afternoon.'],['Cinnamon roll','cinnamon-roll','pastry','6.00','Soft dough, cinnamon swirls, cream cheese icing.'],['Rosemary focaccia','focaccia','bread','8.00','Olive oil, sea salt, and a generous helping of rosemary.'],['Dark chocolate brownie','brownie','cake','5.00','Rich chocolate, a delicate crust, and a fudgy middle.']];
---
<Layout title="Bella’s Bakery | A Violet Media Website Concept" description="A fictional neighbourhood bakery website: fresh bread, beautiful pastries, and a warm welcome. An interactive design concept by Violet Media." theme="bakery" demo image="/media/starter-bakery-interior-1280.webp">
  <DemoBanner name="Bella’s Bakery" key="bakery" />
  <Header brand="Bella’s" sub="THE NEIGHBOURHOOD BAKERY" home="/demos/bakery/" kind="bakery" links={[["Our story","#story"],["The counter","#menu"],["Visit us","#visit"]]} cta="Something special?" target="#enquire" />
  <main id="main">
    <section class="bakery-hero"><div class="wrap bakery-hero-grid"><div class="bakery-intro fade-in"><p class="eyebrow">Slow mornings. Fresh from the oven.</p><h1>Good things<br/>take <em>butter.</em></h1><p>Bread with a little patience. Pastries with a lot of love. Your new favourite corner of the neighbourhood.</p><div class="actions"><a class="button" href="#menu">See what’s baking <span aria-hidden="true">↗</span></a><a class="text-link" href="#visit">Come say hello →</a></div><div class="bakery-hero-note"><span class="bakery-sun" aria-hidden="true">✳</span><span>A little flour.<br/>A little warmth. A good morning.</span></div></div><div class="bakery-hero-photo"><Photo name="starter-bakery-interior" alt="Sunlit bakery with baskets of bread and a warm timber counter" eager/><span class="bakery-stamp">BAKED WITH TIME<br/><b>made to<br/>be shared</b><br/>BELLA’S BAKERY</span></div></div></section>
    <div class="bakery-ribbon"><span>GOOD BREAD</span><i aria-hidden="true">✳</i><span>REAL BUTTER</span><i aria-hidden="true">✳</i><span>SMALL MOMENTS</span><i aria-hidden="true">✳</i><span>WARM WELCOMES</span></div>
    <section id="menu" class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">From our counter</p><h2>Find your<br/><em>usual favourite.</em></h2></div><p>A sample daily menu for our fictional bakery. All example prices are in AUD.</p></div><div class="filters" data-filter-group="menu" role="group" aria-label="Filter the bakery menu"><button data-filter="all" aria-pressed="true">Everything</button><button data-filter="bread" aria-pressed="false">Bread</button><button data-filter="pastry" aria-pressed="false">Pastries</button><button data-filter="cake" aria-pressed="false">Something sweet</button></div><p class="sr-only" data-filter-status="menu" role="status">6 items shown</p><div class="bakery-menu-grid">{menu.map(([name,img,cat,price,desc])=><article class="bake-card" data-filter-item="menu" data-category={cat}><div class="bake-image"><Photo name={`starter-${img}`} alt={name} sizes="(max-width: 600px) 100vw, 33vw"/></div><div class="bake-title"><h3>{name}</h3><span>AUD {price}</span></div><p>{desc}</p></article>)}</div></div></section>
    <section id="story" class="bakery-story"><div class="wrap bakery-story-grid"><Photo name="starter-sourdough" alt="Artisan sourdough with a deeply golden crust"/><div><p class="eyebrow">More than a morning ritual</p><h2>A place to<br/><em>slow down.</em></h2><p>Imagine a bakery built around the things that make a neighbourhood feel like home: familiar faces, a warm counter, and the smell of bread in the morning.</p><p>That is the world of Bella’s. Simple ingredients, thoughtful details, and something lovely to take with you.</p><a class="text-link" href="#enquire">Make an occasion of it ↗</a></div></div></section>
    <section id="visit" class="section"><div class="wrap bakery-visit"><div><p class="eyebrow">Meet you at the counter</p><h2>Your morning,<br/><em>made better.</em></h2><p class="lead">Drop in for a loaf. Stay for a moment.</p><p class="concept-note">Concept location only — this is not a trading bakery.</p></div><div class="bakery-hours"><p class="eyebrow">Sample opening hours</p><div><span>Monday – Friday</span><strong>7am – 4pm</strong></div><div><span>Saturday</span><strong>8am – 3pm</strong></div><div><span>Sunday</span><strong>8am – 1pm</strong></div><p>In a client website, this space would include the verified address, directions, and tap-to-call contact details.</p></div></div></section>
    <section id="enquire" class="section bakery-enquiry"><div class="wrap bakery-enquiry-grid"><div><p class="eyebrow">A little something special</p><h2>Big day?<br/><em>Bring cake.</em></h2><p>Birthdays, office mornings, a thank-you just because. Try our sample special-order enquiry.</p><div class="bakery-order-image"><Photo name="starter-cake" alt="Lemon cake with a delicate glaze"/></div></div><form class="demo-form" data-demo-form data-success="Your sample cake enquiry is complete. This is a concept website: no order was placed and no information was sent or stored."><h3>Something for the table.</h3><p>Interactive demonstration only. Use sample details; no personal information is needed.</p><div class="form-grid"><div class="field"><label for="occasion">The occasion</label><select id="occasion" required><option value="">Choose an occasion</option><option>Birthday</option><option>Work gathering</option><option>A gift</option><option>Just because</option></select></div><div class="field"><label for="guests">How many people?</label><select id="guests"><option>4–8</option><option>8–16</option><option>16–30</option></select></div><div class="field full"><label for="cake-style">Your favourite</label><select id="cake-style"><option>Lemon drizzle cake</option><option>Chocolate celebration cake</option><option>Pastry selection</option><option>Let’s talk about it</option></select></div><div class="field full"><label for="cake-note">A little more about it (optional)</label><textarea id="cake-note" maxlength="500" placeholder="A sample note about your occasion…"></textarea></div></div><button class="button" type="submit">Try the enquiry <span aria-hidden="true">→</span></button><p class="form-status" role="status" tabindex="-1" hidden></p></form></div></section>
  </main><footer class="wrap"><div class="bakery-footer-word">Bella’s<span>GOOD THINGS, EVERY DAY.</span></div><div class="demo-footer"><span>Fictional bakery concept · Designed by Violet Media</span><a href="/?concept=bakery#contact">Let’s build a website for your business ↗</a><a href="/#work">Back to all concepts</a></div></footer>
</Layout>
