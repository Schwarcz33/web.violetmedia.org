---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import DemoBanner from '../../../components/DemoBanner.astro';
import Photo from '../../../components/Photo.astro';
import { projects } from '../../../data/interiors';
---
<Layout title="Noir & Co. | An Interior Design Website Concept by Violet Media" description="A considered architectural portfolio with residential and commercial project stories. A fictional interior design studio, created by Violet Media." theme="interiors" demo>
  <DemoBanner name="Noir & Co." key="interiors" />
  <Header brand="NOIR & CO." sub="INTERIORS, CONSIDERED" home="/demos/interiors/" kind="interiors" links={[["Selected spaces","#spaces"],["The studio","#studio"],["Our process","#process"]]} cta="Begin a conversation" target="#consultation" />
  <main id="main">
    <section class="interior-hero wrap"><div class="interior-hero-heading"><p class="eyebrow">A considered way of living</p><h1>Spaces for<br/><em>living well.</em></h1><p>Warmth. Restraint. A sense of belonging.<br/>Interiors imagined around the life within them.</p></div><div class="interior-hero-photo"><Photo name="premium-portfolio-1" alt="Warm timber residence with floor-to-ceiling city views" eager sizes="100vw"/><span class="interior-photo-caption">01 / THE CITY RESIDENCE</span><a href="#spaces" aria-label="Explore selected spaces" class="interior-scroll">↓</a></div><div class="interior-hero-foot"><span>RESIDENTIAL & COMMERCIAL CONCEPTS</span><span>A DIFFERENT KIND OF QUIET.</span></div></section>
    <section id="studio" class="section"><div class="wrap interior-statement"><p class="eyebrow">The studio</p><h2>A room should feel<br/>as good as it <em>looks.</em></h2><div><p>Noir & Co. is an imagined design studio with a simple philosophy: thoughtful spaces make room for life. Natural materials, careful proportions, and a sense of calm sit at the heart of every concept.</p><p>This portfolio demonstrates how an interior design business can tell its story through generous imagery, considered detail, and a clear path to a conversation.</p></div></div></section>
    <section id="spaces" class="section interior-projects"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">A selection of spaces</p><h2>Different lives.<br/><em>Shared intention.</em></h2></div><p>Explore three fictional projects. Each one offers a different expression of the studio’s approach.</p></div><div class="interior-project-grid">{projects.map(p=><article><a href={`/demos/interiors/projects/${p.slug}/`} class="interior-project-image"><Photo name={p.image} alt={`${p.name} — ${p.intro}`} sizes="(max-width: 700px) 100vw, 60vw"/><span aria-hidden="true">↗</span></a><div class="interior-project-caption"><div><p>{p.category} / Concept {p.number}</p><h3><a href={`/demos/interiors/projects/${p.slug}/`}>{p.name}</a></h3></div><span>{p.number}</span></div></article>)}</div></div></section>
    <section id="process" class="section interior-process"><div class="wrap interior-process-grid"><div><p class="eyebrow">From first thought to final detail</p><h2>Good spaces<br/>start with<br/><em>listening.</em></h2><Photo name="premium-parallax" alt="A richly textured interior detail"/></div><div class="interior-process-steps">{[['01','Understand','A conversation about the way you live, the space you have, and what you hope it could become.'],['02','Imagine','A shared direction takes shape through layouts, materials, and visual references.'],['03','Resolve','The details are brought together, with every choice considered as part of the whole.'],['04','Bring to life','A clear plan guides the final stages, from individual elements to the feeling of the finished space.']].map(([n,t,d])=><div><span>{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></div></section>
    <section id="consultation" class="section"><div class="wrap interior-consultation"><div><p class="eyebrow">Room for a conversation</p><h2>Tell us about<br/><em>your space.</em></h2><p>A home, a new venture, or simply an idea. Try a sample consultation brief below.</p><p class="concept-note">Noir & Co. is a fictional studio. Project imagery and narratives are illustrative concepts, not completed client commissions.</p></div><form class="demo-form" data-demo-form data-success="Your sample design brief is complete. No consultation was booked and no information was sent or stored. This is a demonstration by Violet Media."><h3>A first conversation.</h3><p>Try the experience with the example choices. No personal details are needed.</p><div class="form-grid"><div class="field"><label for="space-type">The space *</label><select id="space-type" required><option value="">Please select</option><option>A home</option><option>A workplace</option><option>A retail space</option><option>Another idea</option></select></div><div class="field"><label for="space-stage">Where are you now?</label><select id="space-stage"><option>Exploring possibilities</option><option>Ready to plan</option><option>Already underway</option></select></div><div class="field full"><label for="space-feeling">What should the space feel like?</label><select id="space-feeling"><option>Warm and welcoming</option><option>Quiet and restorative</option><option>Confident and expressive</option><option>Let’s discover that together</option></select></div><div class="field full"><label for="space-note">A little about your idea (optional)</label><textarea id="space-note" placeholder="Describe an imagined space…" maxlength="500"></textarea></div></div><button class="button" type="submit">Preview your brief <span aria-hidden="true">↗</span></button><p class="form-status" role="status" tabindex="-1" hidden></p></form></div></section>
  </main><footer class="wrap"><div class="interior-footer-word">NOIR & CO.<span>INTERIORS, CONSIDERED.</span></div><div class="demo-footer"><span>A fictional studio · A Violet Media concept</span><a href="/?concept=interiors#contact">A considered website for your business ↗</a><a href="/#work">Back to all concepts</a></div></footer>
</Layout>
