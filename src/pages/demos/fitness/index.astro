---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import DemoBanner from '../../../components/DemoBanner.astro';
import Photo from '../../../components/Photo.astro';
const classes=[['Mon','06:00','Strength Lab','Strength','60 min','All levels'],['Mon','17:30','HIIT Circuit','Conditioning','45 min','All levels'],['Tue','07:00','Mobility Reset','Recovery','40 min','All levels'],['Wed','06:00','Strength Lab','Strength','60 min','All levels'],['Thu','18:00','Boxing Fit','Conditioning','45 min','Beginner friendly'],['Fri','07:00','Mobility Reset','Recovery','40 min','All levels'],['Sat','08:00','Team Session','Conditioning','50 min','All levels']];
const plans=[['Drop in','25','visit','One session. Get a feel for the space.',['Gym floor access','A first step, without commitment'],''],['Train','55','week','Your routine starts here.',['Gym floor and group classes','A structured training programme','A place in the community'],'recommended'],['Progress','85','week','More guidance. A plan that moves with you.',['Everything in Train','Two personal training sessions per week','Regular progress conversations'],'']];
---
<Layout title="Apex Fitness | A Violet Media Website Concept" description="Explore a fictional fitness studio with a filterable timetable, clear memberships and a sample trial-booking journey. Designed by Violet Media." theme="fitness" demo image="/media/standard-exterior-1280.webp">
  <DemoBanner name="Apex Fitness" key="fitness" />
  <Header brand="APEX /" sub="TRAIN WITH INTENTION" home="/demos/fitness/" kind="fitness" links={[["The studio","#studio"],["Timetable","#timetable"],["Memberships","#memberships"]]} cta="Find your first session" target="#trial" />
  <main id="main">
    <section class="fitness-hero"><Photo name="standard-exterior" alt="Apex Fitness concept exterior at dusk with illuminated green and white signage" eager sizes="100vw"/><div class="fitness-hero-shade"></div><div class="wrap fitness-hero-content"><p class="eyebrow">Strength. Structure. A fresh start.</p><h1>YOU BRING<br/>THE <em>EFFORT.</em><br/>WE BRING<br/>THE DIRECTION.</h1><div class="fitness-hero-bottom"><p>A space to get stronger. A programme to follow. People in your corner, from day one.</p><a href="#timetable" class="button">Find your session <span aria-hidden="true">↗</span></a></div></div><div class="fitness-side-label" aria-hidden="true">ONE SESSION AT A TIME / APEX FITNESS</div></section>
    <div class="fitness-strip"><div class="wrap"><span>STRENGTH TRAINING</span><span>GROUP SESSIONS</span><span>PERSONAL COACHING</span><span>RECOVERY & MOBILITY</span></div></div>
    <section id="studio" class="section"><div class="wrap fitness-studio-grid"><div><p class="eyebrow">01 / Find your footing</p><h2>YOU DON’T NEED<br/>TO BE <em>READY.</em><br/>JUST SHOW UP.</h2><p class="lead">Good training begins with a clear next step. Our concept studio brings coached sessions, room to train, and time to recover into one place.</p><a href="#trial" class="text-link">Explore a first session ↗</a></div><div class="fitness-photo-stack"><Photo name="standard-gallery-1" alt="Training equipment in the Apex concept studio"/><div><span>01—</span><p>Room to focus.<br/>Support to progress.</p></div></div></div></section>
    <section id="timetable" class="section timetable-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">02 / Make time for yourself</p><h2>YOUR WEEK.<br/><em>YOUR SESSION.</em></h2></div><p>Explore the sample week. Filter by training style and choose a session to try the booking demonstration.</p></div><div class="filters" data-filter-group="classes" role="group" aria-label="Filter classes"><button data-filter="all" aria-pressed="true">All sessions</button><button data-filter="Strength" aria-pressed="false">Strength</button><button data-filter="Conditioning" aria-pressed="false">Conditioning</button><button data-filter="Recovery" aria-pressed="false">Recovery</button></div><p class="sr-only" data-filter-status="classes" role="status">7 classes shown</p><div class="schedule-header" aria-hidden="true"><span>DAY / TIME</span><span>SESSION</span><span>DETAILS</span><span>YOUR NEXT STEP</span></div><div class="schedule">{classes.map(([day,time,name,type,length,level])=><article class="schedule-row" data-filter-item="classes" data-category={type}><div class="schedule-time"><strong>{day}</strong><span>{time}</span></div><div><h3>{name}</h3><p>{type}</p></div><div class="schedule-details"><span>{length}</span><span>{level}</span></div><button class="session-button" data-class-name={`${day} ${time} — ${name}`} aria-label={`Try ${name} on ${day} at ${time}`}>Try this session <span aria-hidden="true">↗</span></button></article>)}</div><p class="concept-note">Illustrative timetable. This is a fictional studio; no real sessions or availability are offered.</p></div></section>
    <section id="memberships" class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">03 / A rhythm that works for you</p><h2>CHOOSE YOUR<br/><em>STARTING POINT.</em></h2></div><p>Example membership options for this concept. All prices in AUD; no purchases or subscriptions can be made here.</p></div><div class="fitness-plan-grid">{plans.map(([name,price,period,desc,features,style])=><article class:list={['fitness-plan',style]}><span class="eyebrow">{name}</span><p class="fitness-price"><small>AUD</small> {price}<span>/{period}</span></p><p>{desc}</p><ul>{features.map(f=><li>{f}</li>)}</ul><a href="#trial" data-plan={name} class="button outline">Explore {name} <span aria-hidden="true">↗</span></a></article>)}</div></div></section>
    <section id="trial" class="section fitness-trial"><div class="wrap fitness-trial-grid"><div><p class="eyebrow">04 / Start where you are</p><h2>YOUR FIRST<br/>STEP IS<br/><em>RIGHT HERE.</em></h2><p>See how a simple booking journey could work. Pick your session, tell us your focus, and view a demo confirmation.</p><Photo name="standard-gallery-3" alt="Commercial training floor with green turf, cable machines and rowing equipment"/></div><form class="demo-form" data-demo-form data-success="You’ve completed the sample trial journey. No session was booked and no information was sent or stored. This interaction can be connected to a real booking provider in a client project."><h3>Find your first session.</h3><p>Demo only. Use the example choices below. No contact details or payment are needed.</p><div class="form-grid"><div class="field full"><label for="trial-class">Choose a sample session *</label><select id="trial-class" required><option value="">Select a session</option>{classes.map(([day,time,name])=><option>{day} {time} — {name}</option>)}</select></div><div class="field full"><label for="trial-plan">Membership you’re exploring</label><select id="trial-plan"><option>Not sure yet</option><option>Drop in</option><option>Train</option><option>Progress</option></select></div><div class="field full"><label for="trial-focus">Your training focus</label><select id="trial-focus"><option>Build a consistent routine</option><option>Get stronger</option><option>Improve fitness</option><option>Move more comfortably</option></select></div></div><button class="button" type="submit">Preview my first step <span aria-hidden="true">↗</span></button><p class="form-status" role="status" tabindex="-1" hidden></p></form></div></section>
  </main><footer class="wrap"><div class="fitness-footer-word">APEX / <span>MAKE YOUR NEXT MOVE.</span></div><div class="demo-footer"><span>Fictional fitness concept · Designed by Violet Media</span><a href="/?concept=fitness#contact">A website that works as hard as you do ↗</a><a href="/#work">Back to all concepts</a></div></footer>
</Layout>
